<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FitFuel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- System splash screen shown while MainActivity is starting. -->
    <style name="Theme.FitFuel.Starting" parent="Theme.SplashScreen">
        <!-- Reuse the launcher icon background so splash and app icon stay visually consistent. -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <!-- Reuse the vector foreground generated by Image Asset Studio. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FitFuel</item>
    </style>
</resources>
